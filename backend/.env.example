# =============================================================================
#  EduCore - variáveis de ambiente
# -----------------------------------------------------------------------------
#  1. Copie este arquivo para backend/.env
#       Windows:      copy backend\.env.example backend\.env
#       Linux/macOS:  cp backend/.env.example backend/.env
#  2. Preencha os valores abaixo.
#
#  O arquivo .env NUNCA deve ser enviado ao Git (já está no .gitignore).
# =============================================================================


# --- Segurança ---------------------------------------------------------------
# Chave usada para assinar o cookie de sessão do Flask. Obrigatória.
# Gere uma chave aleatória com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria


# --- Banco de dados ----------------------------------------------------------
# Connection string do PostgreSQL. Obrigatória.
#
# Neon: Dashboard > Connect > marque "Connection pooling" e copie a URL.
# Pode colar exatamente como o Neon mostra (postgresql://...): o config.py
# ajusta o prefixo para o driver psycopg automaticamente.
DATABASE_URL=postgresql://USUARIO:SENHA@ep-xxxx-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Alternativas:
#   PostgreSQL local:  postgresql://postgres:postgres@localhost:5432/educore
#   SQLite (testes):   sqlite:///educore.db


# --- Execução ----------------------------------------------------------------
# Modo debug do Flask (1 = ligado, 0 = desligado). Use 0 em produção.
FLASK_DEBUG=1


# --- Usuários iniciais -------------------------------------------------------
# Usadas apenas na primeira execução, quando a tabela "usuarios" está vazia.
# Se ficarem em branco, valem as senhas de desenvolvimento:
#   secretaria 012345 | instrutor 123456 | coordenacao 234567
SENHA_SECRETARIA=
SENHA_INSTRUTOR=
SENHA_COORDENACAO=
