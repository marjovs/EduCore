# Copie este arquivo para backend/.env e preencha os valores.
# O arquivo .env NÃO vai para o Git (está no .gitignore).

# Chave usada para assinar a sessão do Flask.
# Gere uma com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria

# Connection string do Neon (Dashboard > Connect > marque "Connection pooling").
# Pode colar exatamente como o Neon mostra (postgresql://...); o config.py ajusta o driver.
DATABASE_URL=postgresql://USUARIO:SENHA@ep-xxxx-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Modo debug do Flask (1 = ligado). Use 0 em produção.
FLASK_DEBUG=1

# Senhas dos usuários iniciais (usadas só na primeira execução, quando a
# tabela "usuarios" está vazia). Se não forem definidas, valem as senhas
# de desenvolvimento 012345 / 123456 / 234567.
SENHA_SECRETARIA=
SENHA_INSTRUTOR=
SENHA_COORDENACAO=
